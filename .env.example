# Free key, no credit card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Yaa Groq use karo (free, fast): https://console.groq.com  pe free key lo
# MODEL_PROVIDER=groq
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=openai/gpt-oss-20b

# Ollama local (free, offline) - after `ollama pull qwen2.5:7b-instruct`
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_HOST=http://localhost:11434

# Agent workspace - "." = project root (read-only by default)
# "./workspace" = sandboxed demo folder
AGENT_WORKSPACE=.
# Set to false to allow write/edit/shell on project root (dangerous)
# AGENT_READ_ONLY=true

# Optional: context window management
# Summarize conversation when estimated tokens exceed this budget.
# Lower = summarize sooner (saves tokens, keeps context fresh).
# CONTEXT_BUDGET_TOKENS=50000
# Number of recent turns to always keep (never summarize these).
# SUMMARIZE_TAIL_TURNS=6

# Security / P0 hardening (recommended for end-users)
# Require human approval before destructive tools (write/edit/shell) in extension
# HELIX_REQUIRE_APPROVAL=true
# Planner-Worker: propose plan and ask approval before any edits (safer for large tasks)
# HELIX_PLANNER=true
# Protect web backend with token (set same in VS Code settings agentic.backendToken)
# HELIX_API_TOKEN=your-random-token-here
# Restrict CORS origins (default localhost only)
# CORS_ALLOW_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Optional: sandbox tuning
# SANDBOX_ENABLED=true
# SANDBOX_IMAGE=python:3.12-slim
