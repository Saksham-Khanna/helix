#!/usr/bin/env bash
set -euo pipefail

APP=helix
REPO="Saksham-Khanna/terminal-assistant"
INSTALL_DIR="${HELIX_INSTALL_DIR:-$HOME/.helix/bin}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

requested_version="${VERSION:-}"
no_modify_path=false

usage() {
cat <<EOF
Helix Installer (like opencode install)

Usage: install [options]

Options:
  -h, --help              Display this help message
  -v, --version <version> Install a specific version (e.g., 0.1.0)
      --no-modify-path    Don't modify shell config files (.bashrc, .zshrc, etc.)

Examples:
  curl -fsSL https://raw.githubusercontent.com/${REPO}/main/install | bash
  curl -fsSL https://raw.githubusercontent.com/${REPO}/main/install | bash -s -- --version 0.1.0
  VERSION=0.1.0 curl -fsSL https://raw.githubusercontent.com/${REPO}/main/install | bash

Other install methods:
  pip install git+https://github.com/${REPO}.git
  pipx install git+https://github.com/${REPO}.git
  pip install helix  # after PyPI publish
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version) requested_version="$2"; shift 2 ;;
    --no-modify-path) no_modify_path=true; shift ;;
    --version=*) requested_version="${1#*=}"; shift ;;
    *) echo -e "${RED}Unknown option: $1${NC}"; usage; exit 1 ;;
  esac
done

print_msg() {
  local level=$1; local msg=$2; local color=""
  case $level in info) color="${GREEN}";; warning) color="${YELLOW}";; error) color="${RED}";; esac
  echo -e "${color}${msg}${NC}"
}

# --- detect python ---
PYTHON=""
for cmd in python3 python; do
  if command -v "$cmd" >/dev/null 2>&1; then
    if "$cmd" -c "import sys; exit(0 if sys.version_info >= (3,10) else 1)" 2>/dev/null; then
      PYTHON="$cmd"
      break
    fi
  fi
done

if [[ -z "$PYTHON" ]]; then
  print_msg error "Python 3.10+ is required but not found. Install from https://python.org"
  exit 1
fi

PY_VER=$($PYTHON -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
print_msg info "Found Python ${YELLOW}${PY_VER}${GREEN} at ${YELLOW}$(command -v $PYTHON)${NC}"

# --- detect pip / pipx ---
PIP_CMD=""
if command -v pipx >/dev/null 2>&1; then
  PIP_CMD="pipx"
  print_msg info "Using ${ORANGE}pipx${GREEN} (isolated install)"
elif $PYTHON -m pip --version >/dev/null 2>&1; then
  PIP_CMD="pip"
else
  print_msg error "'pip' not found. Run: $PYTHON -m ensurepip --upgrade"
  exit 1
fi

# --- build pip package spec ---
if [[ -n "$requested_version" ]]; then
  PKG_SPEC="git+https://github.com/${REPO}.git@v${requested_version}"
  print_msg info "Installing ${ORANGE}${APP} ${YELLOW}v${requested_version}${GREEN} from GitHub..."
else
  PKG_SPEC="git+https://github.com/${REPO}.git"
  print_msg info "Installing ${ORANGE}${APP} ${YELLOW}latest${GREEN} from GitHub..."
  # also try to fetch latest tag for display
  if command -v curl >/dev/null 2>&1; then
    latest=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -1 || true)
    if [[ -n "$latest" ]]; then
      print_msg info "Latest release: ${YELLOW}v${latest}${NC}"
    fi
  fi
fi

# --- install ---
if [[ "$PIP_CMD" == "pipx" ]]; then
  if pipx list 2>/dev/null | grep -q "package ${APP} "; then
    print_msg info "Upgrading existing pipx install..."
    pipx upgrade "$APP" --spec "$PKG_SPEC" 2>/dev/null || pipx reinstall "$APP" --spec "$PKG_SPEC" || pipx install "$PKG_SPEC" --force
  else
    pipx install "$PKG_SPEC" --force
  fi
else
  # pip --user install, avoid breaking system pip
  $PYTHON -m pip install --upgrade --user "$PKG_SPEC"
fi

# --- verify ---
if command -v agentic >/dev/null 2>&1; then
  INSTALLED_VER=$(agentic --version 2>/dev/null | head -1 || echo "installed")
  print_msg info "✓ ${ORANGE}agentic${GREEN} installed: ${YELLOW}${INSTALLED_VER}${NC}"
elif command -v helix >/dev/null 2>&1; then
  print_msg info "✓ ${ORANGE}helix${GREEN} installed"
else
  USER_BASE_BIN=$($PYTHON -m site --user-base 2>/dev/null)/bin
  if [[ -x "$USER_BASE_BIN/agentic" ]]; then
    print_msg warning "Installed to $USER_BASE_BIN but not in PATH"
  else
    print_msg warning "Install finished but 'agentic' not found in PATH. You may need to add pip user bin to PATH."
  fi
fi

# --- add to PATH ---
add_to_path() {
  local config_file=$1
  local command=$2
  if [[ ! -f "$config_file" ]]; then return; fi
  if grep -q ".local/bin" "$config_file" 2>/dev/null || grep -q ".helix/bin" "$config_file" 2>/dev/null; then
    return
  fi
  if [[ -w "$config_file" ]]; then
    echo "" >> "$config_file"
    echo "# helix" >> "$config_file"
    echo "$command" >> "$config_file"
    print_msg info "Added ${ORANGE}~/.local/bin${GREEN} to PATH in ${YELLOW}$config_file${NC}"
  else
    print_msg warning "Manually add to $config_file: $command"
  fi
}

if [[ "$no_modify_path" == false ]]; then
  # pip --user puts binaries in ~/.local/bin
  USER_BIN="$HOME/.local/bin"
  PIPX_BIN="$HOME/.local/bin"  # pipx also uses this
  SHELL_NAME=$(basename "${SHELL:-bash}")

  # Only add if not already in PATH
  if [[ ":$PATH:" != *":$USER_BIN:"* ]]; then
    case "$SHELL_NAME" in
      zsh) add_to_path "$HOME/.zshrc" 'export PATH="$HOME/.local/bin:$PATH"' ;;
      bash) add_to_path "$HOME/.bashrc" 'export PATH="$HOME/.local/bin:$PATH"' ;;
      fish) add_to_path "$HOME/.config/fish/config.fish" 'fish_add_path $HOME/.local/bin' ;;
      *) add_to_path "$HOME/.bashrc" 'export PATH="$HOME/.local/bin:$PATH"'
         add_to_path "$HOME/.zshrc" 'export PATH="$HOME/.local/bin:$PATH"' ;;
    esac
    print_msg info "Restart your shell or run: ${YELLOW}export PATH=\"\$HOME/.local/bin:\$PATH\"${NC}"
  fi
fi

cat <<EOF

${GREEN}Done! Next steps:${NC}
  1. ${YELLOW}agentic setup${NC}          # Gemini/Groq/Ollama wizard (Ollama: no key, local)
  2. ${YELLOW}agentic index${NC}          # index your project for RAG search
  3. ${YELLOW}agentic chat${NC}           # start coding

Docs: https://github.com/${REPO}#readme
EOF
